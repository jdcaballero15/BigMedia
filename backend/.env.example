POSTGRES_DB=bigmedia
POSTGRES_USER=bigmedia
POSTGRES_PASSWORD=replace-with-local-password
DB_HOST=127.0.0.1
DB_PORT=5433
DJANGO_SECRET_KEY=replace-with-local-secret-key
DJANGO_DEBUG=true
# Minutos de inactividad antes de expirar la sesión (default: 30).
DJANGO_SESSION_IDLE_MINUTES=30
# Intentos fallidos seguidos antes de bloquear el ingreso, y minutos de bloqueo (default: 5 y 15).
DJANGO_LOGIN_MAX_INTENTOS=5
DJANGO_LOGIN_BLOQUEO_MINUTOS=15
# Horas de validez del link para definir o restablecer la contraseña (HU-005).
DJANGO_LINK_CLAVE_HORAS=72
# Solo staging: contraseña de los usuarios de demo de cargar_datos_ejemplo (vacía: no se crean).
DJANGO_DEMO_PASSWORD=
# Tamaño máximo en MB del PDF de la orden de compra de un ítem a facturar (default: 5).
FACTURACION_OC_MAX_MB=5
# Correo saliente (HU-067). Sin EMAIL_HOST los correos se escriben en la consola.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=
# Dirección de Administración que recibe los avisos de ítems reabiertos (vacía: no se avisa).
FACTURACION_CORREO_ADMINISTRACION=
