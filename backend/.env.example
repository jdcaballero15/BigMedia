POSTGRES_DB=bigmedia
POSTGRES_USER=bigmedia
POSTGRES_PASSWORD=replace-with-local-password
DB_HOST=127.0.0.1
DB_PORT=5433
DJANGO_SECRET_KEY=replace-with-local-secret-key
DJANGO_DEBUG=true
# Minutos de inactividad antes de expirar la sesión (default: 30).
DJANGO_SESSION_IDLE_MINUTES=30
# Intentos fallidos seguidos antes de bloquear el ingreso, y minutos de bloqueo (default: 5 y 15).
DJANGO_LOGIN_MAX_INTENTOS=5
DJANGO_LOGIN_BLOQUEO_MINUTOS=15
# Solo staging: contraseña de los usuarios de demo de cargar_datos_ejemplo (vacía: no se crean).
DJANGO_DEMO_PASSWORD=
